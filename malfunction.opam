opam-version: "2.0"
version: "0.7.1+ox"
maintainer: "The Peregrine team"
authors: ["Stephen Dolan" "The Peregrine team (OxCaml port)"]
homepage: "https://github.com/peregrine-project/malfunction-oxcaml"
bug-reports: "https://github.com/peregrine-project/malfunction-oxcaml/issues"
dev-repo: "git+https://github.com/peregrine-project/malfunction-oxcaml.git"
license: "LGPL-2.0-or-later"
build: [
  [ "dune" "build" "-p" name "-j" jobs ]
]
# Malfunction uses the compiler's internal Lambda API, so this port builds
# against one OxCaml compiler only: ocaml-variants 5.2.0+ox from the OxCaml
# opam repository at f1bd228dda31430bf6271f0f9adb2e604c6957ca.
depends: [
  "ocaml-variants" {= "5.2.0+ox"}
  "ocamlfind"
  "dune" {>= "1.11"}
  "zarith"
]
synopsis: "Malfunction 0.7.1 ported to the OxCaml compiler"
description: """
Malfunction is a high-performance, low-level untyped program
representation, designed as a target for compilers of functional
programming languages. This is Malfunction 0.7.1 ported to the OxCaml
compiler (ocaml-variants 5.2.0+ox), which compiles it with flambda2."""
